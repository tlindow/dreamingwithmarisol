# Public site URL used for checkout return links, sitemap, and email download links.
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# Stripe test keys. Checkout charges the Price ID stored on each product.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# HMAC secret for download links. Use a long random string.
DOWNLOAD_TOKEN_SECRET=

# Private file storage for PDFs. Required for files larger than about 20 MB.
BLOB_READ_WRITE_TOKEN=

# Transactional email. No custom domain is required; the default sender is Resend's onboarding address.
RESEND_API_KEY=
EMAIL_FROM=

# Stytch Consumer project. A project id starting with project-test- uses the test API.
# Enable SMS one-time passcodes. Anyone who finishes the texted code can edit /admin.
STYTCH_PROJECT_ID=
STYTCH_SECRET=

# Optional. When set, the booking page can hide embeds if Calendly reports no open times.
CALENDLY_API_TOKEN=
